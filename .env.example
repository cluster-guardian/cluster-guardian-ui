# Where `cluster-guardian serve` is listening. Read by vite.config.ts to set up
# the dev and preview proxies. Not baked into the bundle.
CG_URL=http://127.0.0.1:8099

# Only for split deployments where the SPA and the API are not same-origin.
# Baked into the bundle at build time, and the Go server sends no CORS headers,
# so this only works behind a proxy that adds them. Leave unset otherwise.
# VITE_API_BASE=
